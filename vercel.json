{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/public/sitemap.xml" },
    { "source": "/manifest.json", "destination": "/public/manifest.json" },
    { "source": "/sw.js", "destination": "/public/sw.js" },
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/favicon.png", "destination": "/public/favicon.png" },
    { "source": "/vidsavor-icon.png", "destination": "/public/vidsavor-icon.png" },
    { "source": "/vidsavor-favicon.png", "destination": "/public/vidsavor-favicon.png" },
    { "source": "/og-image.png", "destination": "/public/og-image.png" },
    { "source": "/fetch", "destination": "/api/index.py" },
    { "source": "/api/fetch", "destination": "/api/index.py" },
    { "source": "/api/proxy-download", "destination": "/api/proxy-download.js" },
    { "source": "/proxy-download", "destination": "/api/proxy-download.js" },
    { "source": "/resolve-youtube", "destination": "/api/index.py?action=resolve" },
    { "source": "/api/resolve-youtube", "destination": "/api/index.py?action=resolve" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/api/health", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/reels", "destination": "/instagram.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/about", "destination": "/about-us.html" },
    { "source": "/contact", "destination": "/contact-us.html" },
    { "source": "/help", "destination": "/faq.html" },
    { "source": "/dmca", "destination": "/dmca-policy.html" },
    { "source": "/privacy", "destination": "/privacy-policy.html" },
    { "source": "/terms", "destination": "/terms-of-service.html" }
  ]
}
