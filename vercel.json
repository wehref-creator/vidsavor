    { "source": "/api/proxy-download", "destination": "/api/index.py" },
    { "source": "/proxy-download", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/api/health", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/instagram", "destination": "/instagram.html" },
    { "source": "/youtube", "destination": "/youtube.html" },
    { "source": "/tiktok", "destination": "/tiktok.html" },
    { "source": "/facebook", "destination": "/facebook.html" },
    { "source": "/twitter", "destination": "/twitter.html" },
    { "source": "/pinterest", "destination": "/pinterest.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/help", "destination": "/faq.html" },
    { "source": "/about-us", "destination": "/about-us.html" },
    { "source": "/about", "destination": "/about-us.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/contact-us", "destination": "/contact-us.html" },
    { "source": "/contact", "destination": "/contact-us.html" },
    { "source": "/dmca-policy", "destination": "/dmca-policy.html" },
    { "source": "/dmca", "destination": "/dmca-policy.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/privacy", "destination": "/privacy-policy.html" },
    { "source": "/terms-of-service", "destination": "/terms-of-service.html" },
    { "source": "/terms", "destination": "/terms-of-service.html" },
    { "source": "/reels", "destination": "/instagram.html" },
    { "source": "/audio", "destination": "/audio.html" },
    { "source": "/photo", "destination": "/photo.html" }
  ]
}
